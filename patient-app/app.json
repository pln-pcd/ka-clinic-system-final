{
  "expo": {
    "name": "K&A Clinic",
    "slug": "kna-rabies-monitoring",
    "version": "1.0.0",
    "icon": "./assets/logo-white-nobg.png",
    "splash": {
      "image": "./assets/logo-white-nobg.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow K&A Rabies Monitoring to access your camera so you can take wound photos for monitoring.",
          "photosPermission": "Allow K&A Rabies Monitoring to access your photos so you can upload wound images for monitoring."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C8102E"
        }
      ],
      "expo-router"
    ],
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to capture wound photos for rabies monitoring.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access so you can upload wound images for monitoring."
      },
      "bundleIdentifier": "com.anonymous.kna-rabies-monitoring"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.knarabiesmonitoring",
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo-white-nobg.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "extra": {
      "eas": {
        "projectId": "62297c13-8ceb-4918-9d9e-a9113cbf5acf"
      }
    }
  }
}
