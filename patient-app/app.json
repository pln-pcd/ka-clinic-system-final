{
  "expo": {
    "name": "K&A Clinic",
    "slug": "kna-rabies-monitoring",
    "version": "1.0.22",
    "icon": "./assets/icon.png",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow K&A Clinic to access your camera so you can take a profile photo.",
          "photosPermission": "Allow K&A Clinic to access your photos so you can choose a profile photo."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Allow K&A Clinic to save your vaccination record card to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0A1D47"
        }
      ],
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-white-nobg.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "./plugins/withSecureAndroid"
    ],
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access so you can take a profile photo.",
        "NSPhotoLibraryUsageDescription": "This app needs photo library access so you can choose a profile photo.",
        "NSPhotoLibraryAddUsageDescription": "This app saves your vaccination record card image to your photo library."
      },
      "bundleIdentifier": "com.anonymous.kna-rabies-monitoring"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.knarabiesmonitoring",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "allowBackup": false,
      "versionCode": 22
    },
    "extra": {
      "eas": {
        "projectId": "62297c13-8ceb-4918-9d9e-a9113cbf5acf"
      },
      "apiBaseUrl": "https://ka-clinic-system-final.vercel.app"
    }
  }
}
