{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://ka-clinic-system-final.vercel.app"
      },
      "node": "24.18.0"
    },
    "preview": {
      "node": "24.18.0",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://ka-clinic-system-final.vercel.app"
      }
    },
    "production": {
      "node": "24.18.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://ka-clinic-system-final.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
