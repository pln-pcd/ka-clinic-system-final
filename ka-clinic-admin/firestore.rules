rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function session() {
      return get(/databases/$(database)/documents/securitySessions/$(request.auth.uid + '_' + string(request.auth.token.auth_time))).data;
    }
    function verified(scope) {
      return signedIn() && session().scope == scope
        && request.auth.token.firebase.sign_in_provider == 'custom'
        && session().authTime == request.auth.token.auth_time
        && session().expiresAt > request.time.toMillis();
    }
    function isAdmin() {
      let admin = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      return verified('admin') && admin.status == 'active'
        && admin.role in ['staff', 'manager']
        && (admin.get('lockedUntil', null) == null || admin.lockedUntil <= request.time.toMillis());
    }
    function isManager() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'manager';
    }
    function isPatient() {
      return verified('patient')
        && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/vaccinations/$(session().mrn)).data.get('isArchived', false) != true;
    }
    function owns(d) {
      return isPatient() && (d.get('authUid', '') == request.auth.uid || d.get('uid', '') == request.auth.uid
        || (request.auth.token.get('email', '') != '' && d.get('email', '').lower() == request.auth.token.email.lower()));
    }
    // The settings/counters MRN counter only moves forward: a lower sequence
    // in the same year (a rewind) is refused, and it can never be deleted.
    function counterForward() {
      return resource == null
        || request.resource.data.currentYear > resource.data.currentYear
        || (request.resource.data.currentYear == resource.data.currentYear
          && request.resource.data.lastSequence > resource.data.lastSequence);
    }
    function ownAppointment(d) {
      return isPatient() && (d.get('patientUid', '') == request.auth.uid || d.get('userId', '') == request.auth.uid);
    }
    match /authorizedPatients/{mrn} {
      allow read: if isAdmin() || owns(resource.data);
      allow write: if isAdmin();
    }
    // A patient reads only the MRN their verified sign-in session was issued
    // for (securitySessions, written by the server), never another MRN, even
    // one that carries their email. The case history (caseHistory, earlier
    // services) lives on this same doc, so the same rule covers it.
    match /vaccinations/{mrn} {
      allow read: if isAdmin() || (owns(resource.data) && mrn == session().mrn && resource.data.get('isArchived', false) != true);
      allow create: if isAdmin() && request.resource.data.get('isArchived', false) != true;
      allow update: if isAdmin() && !(request.resource.data.get('isArchived', false) == true && resource.data.get('isArchived', false) != true);
      allow delete: if isAdmin();
    }
    match /appointments/{id} {
      allow read: if isAdmin() || ownAppointment(resource.data);
      allow create: if isAdmin() || (isPatient()
        && request.resource.data.status == 'pending'
        && request.resource.data.get('patientUid', '') == request.auth.uid
        && request.resource.data.get('userId', request.auth.uid) == request.auth.uid
        && request.resource.data.patientId == session().mrn
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
        && request.resource.data.contactNumber is string && request.resource.data.contactNumber.size() > 0 && request.resource.data.contactNumber.size() < 30
        && request.resource.data.date is string && request.resource.data.date.size() > 0 && request.resource.data.date.size() < 60
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 300)));
      allow update: if isAdmin() || (ownAppointment(resource.data)
        && resource.data.status in ['pending', 'confirmed', 'accepted', 'cancellation_pending']
        && request.resource.data.status in ['cancelled', 'cancellation_pending']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancellationRequestedAt', 'cancelReason', 'cancellationReason', 'updatedAt']));
      allow delete: if isAdmin() || (ownAppointment(resource.data) && resource.data.status == 'cancelled');
    }
    // Public occupancy metadata has no names, contact details or MRNs.
    match /appointmentSlots/{id} {
      allow read: if true;
      allow create: if isAdmin() || (isPatient()
        && request.resource.data.heldBy == request.auth.uid
        && request.resource.data.date is string && request.resource.data.time is string
        && request.resource.data.keys().hasOnly(['date', 'time', 'heldBy', 'createdAt']));
      allow update, delete: if isAdmin();
    }
    match /inventory/{id} { allow read, write: if isAdmin(); }
    match /stockMovements/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /patientNotifications/{id} {
      allow read: if isAdmin() || (isPatient() && resource.data.patientId == session().mrn);
      allow write: if isAdmin();
    }
    match /patientAvatars/{mrn} {
      allow read: if isAdmin() || (isPatient() && mrn == session().mrn);
      allow write: if isAdmin();
    }
    match /adminAvatars/{uid} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['dataUrl', 'updatedAt'])
        && request.resource.data.dataUrl is string && request.resource.data.dataUrl.size() < 830000
        && request.resource.data.dataUrl.matches('^data:image/(jpeg|png|webp);base64,.*');
      allow delete: if isAdmin() && request.auth.uid == uid;
    }
    match /incidents/{id} {
      allow read: if isAdmin() && resource.data.isSimulated == true;
      allow create, update: if isAdmin() && request.resource.data.isSimulated == true
        && request.resource.data.keys().hasOnly(['isSimulated', 'simNo', 'type', 'category', 'month', 'lat', 'lng', 'source', 'status', 'createdAt', 'isSeedData', 'mapHidden', 'mapHiddenReason'])
        && (resource == null || resource.data.isSimulated == true);
      allow delete: if isAdmin();
    }
    match /chatThreads/{id} {
      allow read: if isAdmin() || (isPatient() && resource.data.patientUid == request.auth.uid);
      allow create: if isAdmin() || (isPatient() && request.resource.data.patientUid == request.auth.uid
        && request.resource.data.resolved == false && request.resource.data.get('archived', false) == false);
      // A patient's message bumps their own thread in the clinic inbox:
      // lastMessage/lastMessageAt, status back to 'pending' and unread for
      // staff. (Before 1.0.5 status/unread were refused, so every send showed
      // "You do not have permission to send messages" although the message
      // itself was saved, and the inbox never showed it as new.)
      allow update: if isAdmin() || (isPatient() && resource.data.patientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'closedBy', 'closedAt', 'lastMessage', 'lastMessageAt', 'updatedAt', 'status', 'unread'])
        && (!('status' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.status == 'pending')
        && (!('unread' in request.resource.data.diff(resource.data).affectedKeys()) || request.resource.data.unread == true)
        && (!('lastMessage' in request.resource.data.diff(resource.data).affectedKeys()) || (request.resource.data.lastMessage is string && request.resource.data.lastMessage.size() <= 5000))
        && request.resource.data.get('closedBy', 'patient') == 'patient'
        && (resource.data.resolved == false || request.resource.data.resolved == true));
      allow delete: if isAdmin();
    }
    match /chatMessages/{id} {
      allow read: if isAdmin() || (isPatient() && get(/databases/$(database)/documents/chatThreads/$(resource.data.threadId)).data.patientUid == request.auth.uid);
      allow create: if isAdmin() || (isPatient()
        && get(/databases/$(database)/documents/chatThreads/$(request.resource.data.threadId)).data.patientUid == request.auth.uid
        && get(/databases/$(database)/documents/chatThreads/$(request.resource.data.threadId)).data.resolved == false
        && request.resource.data.sender == 'patient'
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 5000
        && request.resource.data.keys().hasOnly(['threadId', 'sender', 'senderName', 'text', 'createdAt']));
      allow update, delete: if isAdmin();
    }
    match /patientSessions/{id} {
      allow read, delete: if isPatient() && resource.data.uid == request.auth.uid;
      allow create, update: if isPatient() && request.resource.data.uid == request.auth.uid
        && request.resource.data.deviceId is string && request.resource.data.deviceId.size() > 0 && request.resource.data.deviceId.size() < 100
        && id == request.auth.uid + '_' + request.resource.data.deviceId
        && request.resource.data.keys().hasOnly(['uid', 'deviceId', 'label', 'platform', 'osVersion', 'lastActiveAt', 'createdAt', 'revoked'])
        && (resource == null || resource.data.uid == request.auth.uid)
        && (resource == null || resource.data.get('revoked', false) != true || request.resource.data.revoked == true);
    }
    match /patientChatState/{uid} {
      allow read, delete: if isAdmin() || (isPatient() && request.auth.uid == uid);
      allow create, update: if false;
    }
    match /settings/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && (id != 'counters' || counterForward());
      allow delete: if isAdmin() && id != 'counters';
    }
    // Every MRN ever issued. Never edited or deleted, so a deleted or purged
    // patient's MRN can never be handed to someone else.
    match /mrnRegistry/{mrn} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.mrn == mrn
        && request.resource.data.keys().hasOnly(['mrn', 'issuedAt', 'issuedBy']);
      allow update, delete: if false;
    }
    // Activity Log: managers read it; staff append entries only as
    // themselves, with their live role and the server time. No one can
    // edit or delete an entry from a client.
    match /activityLog/{id} {
      allow read: if isManager();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['actorUid', 'actorName', 'actorRole', 'action', 'collection', 'docId', 'mrn', 'summary', 'changes', 'createdAt'])
        && request.resource.data.keys().hasAll(['actorUid', 'actorRole', 'action', 'summary', 'createdAt'])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
        && request.resource.data.createdAt == request.time
        && request.resource.data.action is string && request.resource.data.action.size() < 60
        && request.resource.data.summary is string && request.resource.data.summary.size() <= 300
        && (!('changes' in request.resource.data) || (request.resource.data.changes is list && request.resource.data.changes.size() <= 60));
      allow update, delete: if false;
    }
    // Bootstrap identity only; account mutations and trusted credentials are server-owned.
    match /admins/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid && resource.data.status == 'active') || isManager();
      allow list: if isManager();
      allow write: if false;
    }
    match /invites/{token} { allow get: if true; allow list, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
