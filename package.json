{
  "private": true,
  "type": "module",
  "scripts": {
    "create-manager": "node --env-file=.env scripts/admin-tools.mjs create-manager",
    "check-smtp": "node --env-file=.env scripts/admin-tools.mjs check-smtp",
    "emulators": "firebase emulators:start --project demo-ka-clinic --only auth,firestore",
    "seed:demo": "node scripts/demo/demo-data.mjs seed --emulator --project demo-ka-clinic",
    "seed:demo:clear": "node scripts/demo/demo-data.mjs clear --emulator --project demo-ka-clinic",
    "test:archive-clock": "node scripts/demo/test-archive-clock.mjs --emulator --project demo-ka-clinic",
    "archive:overdue:emulator": "node scripts/archive-overdue.mjs --emulator",
    "sweep:doses:emulator": "node scripts/run-dose-sweep.mjs --emulator --seed",
    "sweep:doses:dry": "node --env-file=.env scripts/run-dose-sweep.mjs --dry-run",
    "test:security:rules": "node scripts/security/rules.mjs",
    "test:security:api": "node scripts/security/api.mjs",
    "test:security:headers": "node scripts/security/headers.mjs",
    "test:security:ui": "node scripts/security/ui.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0",
    "playwright": "^1.64.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "jwks-rsa": {
      "jose": "5.10.0"
    }
  }
}
