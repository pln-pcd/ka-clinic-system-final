{
  "buildCommand": "cd ka-clinic-admin && npm install && npm run build",
  "outputDirectory": "ka-clinic-admin/dist",
  "devCommand": "cd ka-clinic-admin && npm run dev -- --port $PORT",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/admin-login",
      "destination": "/api/admin-auth?route=admin-login"
    },
    {
      "source": "/api/send-admin-otp",
      "destination": "/api/admin-auth?route=send-admin-otp"
    },
    {
      "source": "/api/verify-admin-otp",
      "destination": "/api/admin-auth?route=verify-admin-otp"
    },
    {
      "source": "/api/admin-otp",
      "destination": "/api/admin-auth?route=admin-otp"
    },
    {
      "source": "/api/admin-forgot-password",
      "destination": "/api/admin-auth?route=admin-forgot-password"
    },
    {
      "source": "/api/admin-reset-password",
      "destination": "/api/admin-auth?route=admin-reset-password"
    },
    {
      "source": "/api/admin-password",
      "destination": "/api/admin-auth?route=admin-password"
    },
    {
      "source": "/api/devices",
      "destination": "/api/admin-auth?route=devices"
    },
    {
      "source": "/api/admin-invites",
      "destination": "/api/admin-accounts?route=admin-invites"
    },
    {
      "source": "/api/accept-invite",
      "destination": "/api/admin-accounts?route=accept-invite"
    },
    {
      "source": "/api/send-otp",
      "destination": "/api/patient-auth?route=send-otp"
    },
    {
      "source": "/api/verify-otp",
      "destination": "/api/patient-auth?route=verify-otp"
    },
    {
      "source": "/api/send-patient-report",
      "destination": "/api/notifications?route=send-patient-report"
    },
    {
      "source": "/api/send-report",
      "destination": "/api/notifications?route=send-report"
    },
    {
      "source": "/api/archive-read-conversations",
      "destination": "/api/notifications?route=archive-read-conversations"
    },
    {
      "source": "/((?!api/)(?!@)(?!src/)(?!node_modules/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/notifications?route=archive-read-conversations",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/notifications?action=dose-sweep",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/notifications?action=backup-cron",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/notifications?action=patient-archive-sweep",
      "schedule": "30 16 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*.(png|jpg|jpeg|svg|webp|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
