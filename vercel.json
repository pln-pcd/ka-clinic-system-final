{
  "buildCommand": "cd ka-clinic-admin && npm install && npm run build",
  "outputDirectory": "ka-clinic-admin/dist",
  "devCommand": "cd ka-clinic-admin && npm run dev -- --port $PORT",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!api/)(?!@)(?!src/)(?!node_modules/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/archive-read-conversations",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/notifications?action=dose-sweep",
      "schedule": "0 21 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*.(png|jpg|jpeg|svg|webp|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
